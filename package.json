{
  "name": "ai-testing-tool",
  "version": "1.0.0",
  "description": "A tool to test AI by sending a list of questions and processing responses",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint \"src/**/*.ts\" --fix && :"
  },
  "lint-staged": {
    "*": [
      "npm run format",
      "npm run lint",
      "git add"
    ]
  },
  "keywords": [
